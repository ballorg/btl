{
	"version": 4,

	"configurePresets":
	[
		{
			"name": "NinjaBase",

			"binaryDir": "${sourceDir}/build/${hostSystemName}/${presetName}",
			"generator": "Ninja",
			"description": "Build using Ninja generator",
			"cacheVariables":
			{
				"BALL_ENABLE_TESTS": true
			},

			"hidden": true
		},
		{
			"name": "Debug",
			"displayName": "Ninja - Debug",
			"inherits": "NinjaBase",

			"cacheVariables":
			{
				"CMAKE_BUILD_TYPE": "Debug",
				"BALL_ENABLE_ASSERT": true
			}
		},
		{
			"name": "RelWithDebInfo",
			"displayName": "Ninja - Release With Debug Info",
			"description": "Build using Visual Studio generator",
			"inherits": "NinjaBase",

			"cacheVariables":
			{
				"CMAKE_BUILD_TYPE": "RelWithDebInfo"
			}
		},
		{
			"name": "RelWithDebInfoAndAsserts",
			"displayName": "Ninja - Release With Debug Info And Asserts",
			"description": "Build using Visual Studio generator",
			"inherits": "NinjaBase",

			"cacheVariables":
			{
				"CMAKE_BUILD_TYPE": "RelWithDebInfo",
				"BALL_ENABLE_ASSERT": true
			}
		},
		{
			"name": "Release",
			"displayName": "Ninja - Release",
			"inherits": "NinjaBase",

			"cacheVariables":
			{
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "ThreadSanitizer",
			"displayName": "Ninja - ThreadSanitizer",
			"description": "Data-race detection for the concurrent containers",
			"inherits": "NinjaBase",

			"cacheVariables":
			{
				"CMAKE_BUILD_TYPE": "RelWithDebInfo",
				"BALL_ENABLE_ASSERT": true,
				"CMAKE_C_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
				"CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
				"CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
			}
		}
	],

	"buildPresets":
	[
		{
			"name": "Debug",

			"displayName": "Ninja - Debug",
			"description": "Debug building with Ninja",
			"configurePreset": "Debug"
		},
		{
			"name": "RelWithDebInfo",

			"displayName": "Ninja - Release With Debug Info",
			"description": "Release With Debug Info building with Ninja configuration",
			"configurePreset": "RelWithDebInfo"
		},
		{
			"name": "RelWithDebInfoAndAsserts",

			"displayName": "Ninja - Release With Debug Info And Asserts",
			"description": "Release With Debug Info And Asserts building with Ninja configuration",
			"configurePreset": "RelWithDebInfoAndAsserts"
		},
		{
			"name": "Release",

			"displayName": "Ninja - Release",
			"description": "Release building with Ninja configuration",
			"configurePreset": "Release"
		},
		{
			"name": "ThreadSanitizer",

			"displayName": "Ninja - ThreadSanitizer",
			"description": "ThreadSanitizer building with Ninja configuration",
			"configurePreset": "ThreadSanitizer"
		}
	],

	"testPresets":
	[
		{
			"name": "Debug",
			"displayName": "CTest - Ninja - Debug",
			"configurePreset": "Debug",
			"output":
			{
				"outputOnFailure": true
			}
		},
		{
			"name": "RelWithDebInfo",
			"displayName": "CTest - Ninja - RelWithDebInfo",
			"configurePreset": "RelWithDebInfo",
			"output":
			{
				"outputOnFailure": true
			}
		},
		{
			"name": "RelWithDebInfoAndAsserts",
			"displayName": "CTest - Ninja - RelWithDebInfoAndAsserts",
			"configurePreset": "RelWithDebInfoAndAsserts",
			"output":
			{
				"outputOnFailure": true
			}
		},
		{
			"name": "Release",
			"displayName": "CTest - Ninja - Release",
			"configurePreset": "Release",
			"output":
			{
				"outputOnFailure": true
			}
		},
		{
			"name": "ThreadSanitizer",
			"displayName": "CTest - Ninja - ThreadSanitizer",
			"configurePreset": "ThreadSanitizer",
			"output":
			{
				"outputOnFailure": true
			}
		}
	]
}
